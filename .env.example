# Copy to .env (git-ignored) and fill in. In CI the same names are repository variables/secrets.

# Deployed frontend (S3 website or CloudFront)
APP_URL=http://<your-frontend-bucket>.s3-website.<region>.amazonaws.com

# Deployed API Gateway stage
API_URL=https://<api-id>.execute-api.<region>.amazonaws.com/<stage>

# Optional: password for every user the tests register (8-16 characters). Default is built in.
# TEST_PASSWORD=

# Optional: run the browser with a window and slow it down for debugging
# HEADED=true
# SLOWMO=300
